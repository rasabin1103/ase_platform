{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://aseplatform-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://aseplatform-production.up.railway.app/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aseplatform-production.up.railway.app/api/:path*"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(LinkedInBot|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|WhatsApp|Discordbot|Pinterest|SkypeUriPreview|vkShare|redditbot).*"
        }
      ],
      "destination": "https://aseplatform-production.up.railway.app/api/v1/public/blog/:slug/preview"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
