{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://aseplatform-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://aseplatform-production.up.railway.app/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aseplatform-production.up.railway.app/api/:path*"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(LinkedInBot|facebookexternalhit|Twitterbot|Slackbot|TelegramBot|WhatsApp|Discordbot|Pinterest|SkypeUriPreview|vkShare|redditbot).*"
        }
      ],
      "destination": "https://aseplatform-production.up.railway.app/api/v1/public/blog/:slug/preview"
    },
    {
      "source": "/(about|academy|admin|app|blog|booking|catalog|contact|dashboard|favorites|forgot-password|job-postings|login|my-books|my-courses|my-library|my-products|my-purchases|my-resources|newsletter|notifications|onboarding|organization|platform|preferencias|pricing|privacy-policy|profile|redeem|redeem-code|register|requests|reset-password|select-organization|services|story|terms-of-service|test-execution|users|verify-email)(/.*)?",
      "destination": "/app-shell.html"
    }
  ]
}
