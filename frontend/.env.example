# Copy to .env.local or .env (never commit real .env files)

# API origin for Vite dev proxy (no trailing slash).
# Local backend (temporal): http://localhost:8000
# Railway production: https://aseplatform-production.up.railway.app
VITE_API_BACKEND=http://localhost:8000

# Browser API base URL (must include /api/v1 — see api/client.ts)
# Local dev: use /api/v1 so requests go through the Vite proxy (avoids CORS).
# Production build on another host: use the full URL instead, e.g.
# VITE_API_URL=https://aseplatform-production.up.railway.app/api/v1
VITE_API_URL=/api/v1

# Public site origin for absolute Open Graph URLs in production (no trailing slash)
# VITE_SITE_URL=https://your-domain.com
