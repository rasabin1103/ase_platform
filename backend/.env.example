# Copy to .env and adjust for your machine (never commit .env)

PROJECT_NAME=Arce Sabin Engineering (ASE) Backend

# PostgreSQL (docker-compose + app)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ase
POSTGRES_USER=ase
POSTGRES_PASSWORD=change-me

# SQLAlchemy URL (required for app + Alembic)
DATABASE_URL=postgresql+psycopg://ase:change-me@localhost:5432/ase

# pgAdmin (docker-compose only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# JWT — generate a strong random value for production
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# MVP: hide legacy multi-tenant HTTP routes
MVP_MODE=true

# Demo seed scripts (scripts/database/seed_*.py, seed_demo_rbac.py)
# Used only in local/dev; do not use weak passwords in production.
DEMO_SEED_PASSWORD=ChangeMeDemo123!

# Fixed identity for the seeded platform super_admin account. Set the real
# password only in your local .env (gitignored) — never commit a real
# password here.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Optional integrations (not required for MVP)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# GitHub personal access token used to auto-invite readers as collaborators
# on private book repos when they redeem a code inside the book. Needs admin
# rights on those repos: a classic PAT with the `repo` scope, or a
# fine-grained PAT with "Administration: write" on the target repos.
# Without this set, code redemption for private repos will fail.
# GITHUB_ACCESS_TOKEN=

# Base URL of the deployed frontend (no trailing slash) — used to build the
# links inside password-reset and email-verification emails.
# Local dev: http://localhost:5173
# Production: https://www.arcesabinengineering.com
FRONTEND_URL=http://localhost:5173

# Transactional email (password reset, email verification) — bring your own
# SMTP server (Gmail Workspace, your hosting provider's mail, Zoho, etc.).
# Leave SMTP_HOST empty to skip sending (logged only) in local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=contact@arcesabinengineering.com
SMTP_FROM_NAME=Arce Sabin Engineering

# Error monitoring — create a free project at sentry.io and paste its DSN
# here. Leave empty to keep Sentry disabled (default, safe for local dev).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared storage for the rate limiter. Leave empty to use in-memory storage
# (fine for a single backend process). Set this to a Redis connection string
# once you run more than one replica, so limits are enforced consistently
# across all of them — e.g. redis://default:password@host:6379
REDIS_URL=

# Cloudflare Turnstile (captcha) on the registration form — get the secret
# key from the Cloudflare dashboard (dash.cloudflare.com -> Turnstile ->
# your widget). Leave empty to skip captcha verification entirely (default,
# safe for local dev). Pair with VITE_TURNSTILE_SITE_KEY in the frontend.
TURNSTILE_SECRET_KEY=
